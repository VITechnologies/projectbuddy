# Copy to docker/windows-sbom/.env (ignored by Git) for Run-WindowsSbom.ps1.
# VIPM Pro activation credentials used inside the container.
VIPM_SERIAL_NUMBER=your-serial-number-here
VIPM_FULL_NAME=Your Full Name
VIPM_EMAIL=your.email@example.com

# Full Dependency-Track reporting is the default; set an API key to use it.
DEPENDENCY_TRACK_API_KEY=
DEPENDENCY_TRACK_URL=https://track.vi-tech.nl
# Optional: set DEPENDENCY_TRACK_MODE=hosted-grype to skip upload/gating explicitly.
#DEPENDENCY_TRACK_PROJECT_NAME=

# Lowest Grype severity that fails the run (negligible|low|medium|high|critical|none).
#GRYPE_FAIL_ON=high

# SVN credentials for SVN projects whose configuration supplies no username and
# password. Alternatively set them as environment variables on this machine;
# values in this file take precedence.
#SVN_GLOBAL_USER=
#SVN_GLOBAL_PASSWORD=
